{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "final_space": false,
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "palette": {
    "text": "#cdd6f4",
    "subtext": "#6c7086",
    "mauve": "#cba6f7",
    "blue": "#89b4fa",
    "green": "#a6e3a1",
    "red": "#f38ba8",
    "yellow": "#f9e2af",
    "teal": "#94e2d5",
    "sky": "#89dceb",
    "peach": "#fab387"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "template": "<p:mauve>({{ .UserName }})</>",
          "min_width": 40
        },
        {
          "type": "path",
          "style": "plain",
          "template": " <p:blue>({{ .Path }})</>",
          "min_width": 90,
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "home_icon": "~"
          }
        },
        {
          "type": "path",
          "style": "plain",
          "template": " <p:blue>({{ .Path }})</>",
          "max_width": 89,
          "options": {
            "style": "folder",
            "home_icon": "~"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "template": " <p:green>({{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Staging.Changed }} <p:yellow>● {{ .Staging.String }}</>{{ end }}{{ if .Working.Changed }} <p:peach>● {{ .Working.String }}</>{{ end }}{{ if gt .StashCount 0 }} <p:mauve>≡{{ .StashCount }}</>{{ end }}{{ if and (gt .Ahead 0) (gt .Behind 0) }} <p:red>↕</>{{ else if gt .Ahead 0 }} <p:red>↑</>{{ else if gt .Behind 0 }} <p:red>↓</>{{ end }})</>",
          "options": {
            "branch_icon": "",
            "branch_template": "{{ trunc 25 .Branch }}"
          }
        },
        {
          "type": "node",
          "style": "plain",
          "template": " <p:teal>(node {{ .Full }})</>",
          "min_width": 140,
          "options": {
            "display_mode": "files"
          }
        },
        {
          "type": "python",
          "style": "plain",
          "template": " <p:peach>(py {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }})</>",
          "min_width": 125,
          "options": {
            "display_mode": "files",
            "fetch_virtual_env": false
          }
        },
        {
          "type": "go",
          "style": "plain",
          "template": " <p:sky>(go {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }})</>",
          "min_width": 110,
          "options": {
            "display_mode": "files"
          }
        },
        {
          "type": "time",
          "style": "plain",
          "template": " <p:subtext>({{ .CurrentDate | date \"15:04:05\" }}{{ if and (.Segments.Executiontime) (gt .Segments.Executiontime.Ms 500.0) }} | {{ .Segments.Executiontime.FormattedMs }}{{ end }})</>",
          "min_width": 100
        },
        {
          "type": "executiontime",
          "style": "plain",
          "template": "{{ if false }}{{ end }}",
          "options": {
            "threshold": 0,
            "style": "austin"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "template": "{{ if gt .Code 0 }}<p:red>✗ {{ .Code }} ❯</>{{ else }}<p:green>❯</>{{ end }} ",
          "foreground": "p:green",
          "options": {
            "always_enabled": true
          }
        }
      ]
    }
  ],
  "transient_prompt": {
    "template": "<p:subtext>{{ now | date \"15:04:05\" }}</> ❯ ",
    "foreground": "p:blue",
    "foreground_templates": [
      "{{ if gt .Code 0 }}p:red{{ end }}"
    ]
  }
}
